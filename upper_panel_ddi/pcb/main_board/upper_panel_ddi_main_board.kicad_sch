	(text "Upper Panel DDI main board (perfboard) — firmware: upper_panel_ddi\nMatrix: 8x5 (GP2-9 rows out, GP10-14 cols in, pulldown in FW)\nIMCP: USB CDC on Pico Micro-USB (115200 logical); GP0/GP1 UART NC\nPower: USB VBUS; max_power 100 mA in firmware USB descriptor\nEight J1..J8 (1x08 each): Pin1 ROW0-7 -> GP2-9 | Pin3-7 COL0-4 -> GP10-14\nPin2 (panel LED) and Pin8 NC on main | Common GND in harness"
		(exclude_from_sim yes)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bf96fece-b253-5fb8-8472-80d70dc41c2a")
	)
	(text "Panel JST 1x08 pinout (same as button_panel J1):\n  1=ROWn (this panel)  2=NC (LED on panel)  3..7=COL0..4 (bus)  8=NC\nSWD: wire to Pico module debug pads (SWDIO/SWCLK/GND); not on symbol."
		(exclude_from_sim yes)
		(at 25.4 248.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "202fe92b-3f82-5061-8b2c-9a27e2bf32ca")
	)
