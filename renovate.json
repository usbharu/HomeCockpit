{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBuffer": "30 minutes",
  "packageRules": [
    {
      "description": "Wait for npm releases to pass pnpm release-age checks before creating update branches.",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Auto-merge patch and minor updates once required checks pass.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeStrategy": "squash"
    }
  ]
}
