{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBuffer": "30 minutes",
  "packageRules": [
    {
      "description": "Wait for npm releases to pass pnpm release-age checks before creating update branches.",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day"
    }
  ]
}
